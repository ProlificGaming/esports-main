generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// |Admin Model|
/// -> email: The key identifier (the invite email)
/// -> username: username & password: Set later by the admin after activation.
/// -> isActive: Prevents login until the admin has completed account setup.
/// -> activationToken: Optional - Use this if you want to send a secure invite link instead of letting them 
/// type their email directly.
///
/// => New fields added on 11-12-2025: You'll be able to invite new admins via email links
/// that expire after activation (or after a set time). 
/// -> activationToken: Unique token for sercure one-time link.
/// -> tokenExpiresAt: Optional - you can expire invites after 24 hours. 
/// -> isActive: Prevents login until the admin activates thier account. 
///
/// => Recommended lockout rules: 
/// This will control the flow of logins for administration prevent brute force login:
/// Max attempts => 5
/// Lockout period => 15 minutes
/// Reset attempts on success => Yes
/// Lockout time extends only once => Yes
model Admin {
  id                   String    @id @default(cuid())
  username             String?   @unique
  password             String?

  role                 String    @default("admin")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime? @updatedAt
  activationToken      String?   @unique

  email                String?
  isActive             Boolean   @default(false)
  tokenExpiresAt       DateTime?

  // Password reset token fields for forgotten password. 
  passwordResetExpires DateTime?
  passwordResetToken   String?

  // Admin lockout fields for failed log in attempts:
  failedLoginAttempts  Int       @default(0)
  attemptsAfterLockout Int       @default(0)
  lockoutUntil         DateTime?

  // Admin Appearance (Page Themes):
  theme                String    @default("orange-creme") // <--- ADD THIS
}

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// |Security Log|
model SecurityLog {
  id                  String      @id @default(cuid())
  ipAddress           String 
  username            String?
  success             Boolean
  reason              String
  userAgent           String?
  createdAt           DateTime    @default(now())
}

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// |Tournament Log|
model TournamentLog{
  id                  String        @id @default(cuid())
  name                String?       @unique
  type                String?
  game                String?
  startDate           DateTime? 
  time                String? 
  playerCount         Int           @default(0)
  description         String? 

  bannerUrl           String?
  bannerPublicId      String?

  status              String        @default("DRAFT") // DRAFT | PUBLI 

  createdById         String?
  createdAt           DateTime      @default(now())
}

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// |Session|
model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String
  expiresAt DateTime
}
