<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Admin Reset Password</title>
        <link rel="stylesheet" href="/styles/styles.css">
    </head>

    <body>
        <%- include('../utils/nav.ejs') %> 

        <section class="admin-reset-password-section">
            <h1>Admin Password Reset Request</h1>

            <form action="/admin/reset-password/<%= token %>" method="POST">
                <div>
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Enter new password"  required />
                </div>

                <div>
                    <label for="passwordMatch">Enter Password again</label>
                    <input type="password" id="passwordMatch" name="passwordMatch" placeholder="Enter new password again" required />
                </div>

                <div>
                    <button type="submit">Submit Password</button>
                </div>
            </form>
        </section>
    </body>
</html>