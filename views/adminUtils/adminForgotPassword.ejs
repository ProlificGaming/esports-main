<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Forgot Password</title>
        <link rel="stylesheet" href="/styles/styles.css">
    </head>

    <body>
        <%- include('../utils/nav.ejs') %>

        <section class="forgot-admin-password-section">
            <h1>Forgot Admin Password</h1>
            
            <form action="/admin/forgot-password" method="POST">
                <div>
                    <label for="email">Email</label>
                    <input type="text" id="email" name="email" placeholder="Enter email here" required /> 
                </div>
                <div>
                    <button type="submit">Submit Email</button>
                </div>
            </form>
        </section>
    </body>
</html>