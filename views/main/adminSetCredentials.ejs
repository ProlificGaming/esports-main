<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Set Credentials</title>
        <link rel="stylesheet" href="/styles/styles.css">
        <script src="/design/setAdminCredentialPasswordStrengthMeter.js" defer></script>
    </head>

    <body>
        <%- include('../utils/nav.ejs', {omit: false}) %>

        <section class="admin-set-credential-section">
            <h2>Set Admin Credentials</h2>

            <form action="/admin/activate/set-credentials" method="POST">
                <div>
                    <input type="hidden" name="userToken" value="<%= locals.token %>">
                </div>

                <div>
                    <input type="hidden" name="userEmail" value="<%= locals.email %>">
                </div>

                <div>
                    <p>Email: <%= email %></p>
                </div>

                <div>
                    <% if (usernameExist) { %>
                        <span class="admin-set-credential-username-exist">
                            <p><%= usernameExistMssg %></p>
                        </span>
                    <% } %> 

                    <% if (!noUsernameError){ %>
                        <span class="admin-set-credential-username-error">
                            <h3><%= usernameRules.invalid %></h3>
                            <ul >
                                <li><%= usernameRules.characters %></li>
                                <li><%= usernameRules.includes %></li>
                                <li><%= usernameRules.noPunc %></li>
                                <li><%= usernameRules.noEndPunc %></li>
                                <li><%= usernameRules.start %></li>
                                <li><%= usernameRules.validExample %></li>
                            </ul>
                        </span>
                    <% } %> 
                    <label for="setUsername">Username</label>
                    <input type="text" id="setUsername" name="setUsername" placeholder="Choose a username" required />
                </div>

                <div>
                    <% if (!noPasswordError){ %>
                        <span class="admin-set-credential-password-error">
                            <h3><%= passwordRules.invalid %></h3>
                            <ul>
                                <li><%= passwordRules.characters %></li>
                                <li><%= passwordRules.uppercase %></li>
                                <li><%= passwordRules.lowercase %></li>
                                <li><%= passwordRules.digit %></li>
                                <li><%= passwordRules.special %></li>
                                <li><%= passwordRules.spaces %></li>
                                <li><%= passwordRules.validExample %></li>
                            </ul>
                        </span>
                    <% } %>
                    <label for="setPassword">Password</label>
                    <input type="password" id="setPassword" name="setPassword" placeholder="Choose a password" required />
                    
                    <div id="password-strength">
                        <div id="strength-bar"></div>
                    </div>

                    <ul class="password-rules">
                        <li id="rule-length">&#10003; 12+ characters</li>
                        <li id="rule-lower">&#10003; lowercase letter</li>
                        <li id="rule-upper">&#10003; uppercase letter</li>
                        <li id="rule-number">&#10003; digit</li>
                        <li id="rule-special">&#10003; special character</li>
                    </ul>
                </div>

                <div>
                    <button type="submit">Activate Account</button>
                </div>
            </form>
        </section>
    </body>
</html>