<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Set Credentials</title>
    </head>

    <body>
        <section class="admin-set-credential-section">
            <h2>Set Admin Credentials</h2>

            <form action="/admin/activate/set-credentials" method="POST">
                <div>
                    <input type="hidden" name="email" value="<%= email %>">
                </div>

                <div>
                    <label for="setUsername">Username</label>
                    <input type="text" id="setUsername" name="setUsername" placeholder="Choose a username" required />
                </div>

                <div>
                    <label for="setPassword">Password</label>
                    <input type="password" id="setPassword" name="setPassword" placeholde="Choose a password" required />
                </div>

                <div>
                    <button type="submit">Submit</button>
                </div>
            </form>
        </section>
    </body>
</html>