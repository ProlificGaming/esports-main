<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %></title>
        <link rel="stylesheet" href="/styles/styles.css">
        <script type="module" src="windows/loginWindow.js" defer></script>
    </head>

    <body>
        <%- include('../utils/nav.ejs') %> 

        <!-- Log-In Window -->
        <section class="log-in-window">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M13.46,12L19,17.54V19H17.54L12,13.46L6.46,19H5V17.54L10.54,12L5,6.46V5H6.46L12,10.54L17.54,5H19V6.46L13.46,12Z"/>
                </svg>
            </div>

            <div>
                <h2>Member Login</h2>
                <form action="/" method="POST">
                    <div>
                        <label for="admin-username">Username</label>
                        <input type="text" id="admin-username" name="admin-username" required /> 
                    </div>

                    <div>
                        <label for="admin-password">Password</label>
                        <input type="password" id="admin-password" name="admin-password" required />
                    </div>

                    <div>
                        <button type="submit">Sumbit</button>
                    </div>
                </form>
            </div>

            <div>
                <div>Forgot Password</div>
                <div>Forgot Username</div>
                <div>Sign Up</div>
            </div>

            <div>
                <a href="/admin">Admin log in</a>
            </div>
        </section>
    </body>
</html>