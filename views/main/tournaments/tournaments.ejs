                                                                </div>
                                                            </div>
                                                        </div>
                                                    </a>
                                                <% } %>
                                            <% }); %> 
                                        <% }else{ %>
                                            <p class="game-viewport-game-coming-soon">Fortnite coming soon.</p>
                                        <% } %> 
                                    <% } %>
                                <% }); %>  
                            </div>

                            <!-- King of Fighters Tournaments -->
                            <div class="game-viewport" data-game="king of fighters">
                                <h2 class="game-viewport-single-game-title">King of Fighters</h2>
                                <% gameSelections.forEach((selection) => { %>
                                    <% if (selection.game === 'King of Fighters'){ %>
                                        <% if (selection.present){ %>
                                            <% tournaments.forEach((tournament) => { %>
                                                <% if (tournament.game === 'King of Fighters'){ %>
                                                    <a href="/tournaments/<%= tournament.name %>" class="game-viewport-tournament-link">
                                                        <div class="game-viewport-tournament-details-container game-viewport-tournament-details-container-ar-6-1">
                                                            <div class="game-viewport-tournament-image-container game-viewport-tournament-image-container-ar-6-1">
                                                                <% if (tournament.bannerUrl !== null){ %>
                                                                    <img src="<%= tournament.bannerUrl %>" alt="<%= tournament.name %> image">
                                                                <% }else{ %>
                                                                    <img src="../../../images/standardGameImages/default_image_aspect_ratio-6-1.png" alt="no image">
                                                                <% } %>
                                                            </div>

                                                            <div class="game-viewport-tournament-details game-viewport-tournament-details-ar-6-1">
                                                                <h3><%= tournament.name %></h3>
                                                                <div>
                                                                    <p><span>TYPE:</span> <span><%= tournament.type %></span></p>
                                                                    <p><span>PLAYER COUNT:</span> <span><%= tournament.playerCount %></span></p>
                                                                    <p><span>START DATE:</span> <span><%= tournament.startDate %></span></p>
                                                                    <p><span>TIME:</span> <span><%= tournament.time %></span></p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </a>
                                                <% } %>
                                            <% }); %>
                                        <% }else{ %>
                                            <p class="game-viewport-game-coming-soon">King of Fighters coming soon.</p>
                                        <% } %>
                                    <% } %>
                                <% }); %> 
                            </div>

                        <% } %>
                    </div>
                <% } else { %> 
                    <div id="tournaments-viewport-container">
                        <p>No tournaments have been posted.</p>
                    </div>
                <% } %> 
            </section>
        </main>
    </body>
</html>