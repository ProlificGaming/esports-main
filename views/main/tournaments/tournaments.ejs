                        <% } else if (tournamentsAr.SectionAspectRatio === 'ar-3-2'){ %> <!-- Tournaments Aspect Ratio 3:2 -->

                        <% } else if (tournamentsAr.SectionAspectRatio === 'ar-4-3'){ %> <!-- Tournaments Aspect Ratio 4:3 -->

