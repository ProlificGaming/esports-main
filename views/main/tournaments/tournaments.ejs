<!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Tournaments</title>
        <link rel="stylesheet" href="/styles/styles.css"> <!-- Main styles for the entire application -->
        <link rel="stylesheet" href="/styles/tournamentsStyles.css"> <!-- Tournaments styles for the tournament page -->

        <script src="windows/loginWindow.js" defer></script>
        <script src="design/tournamentsPageContent.js" defer></script>
    </head>

    <body>
        <!-- Public Navigation Header -->
        <%- include('../../utils/nav.ejs') %>

        <!-- Log In Window -->
        <%- include('../../utils/logInWindow.ejs') %> 

        <!-- Main Tournament Content -->
        <main id="tournament-content">
            <!-- Tournament Content Headliner -->
            <!-- <h1 id="tournament-content-title">Games</h1> -->

            <!-- Tournament Games Slideshow -->
            <section id="tournament-games-slideshow">
                <button class="slideshow-button left">&#10094;</button>

                <div id="games-slideshow-viewport">
                    <div id="games-slideshow-container">
                        <div class="game-card" data-game="apex">
                            <img src="../../../images/standardGameImages/apex-legends-tournament-slide.jpg" alt="Apex Legend Tournament Slide">
                            <span>Apex Legends</span>
                        </div>

                        <div class="game-card" data-game="warzone">
                            <img src="../../../images/standardGameImages/warzone-tournament-slide.jpg" alt="Warzone Tournament Slide">
                            <span>Warzone</span>
                        </div>

                        <div class="game-card" data-game="all">
                            <img src="../../../images/standardGameImages/all-games-tournament-slide.png" alt="All Games Tournament Slide">
                            <span>All</span>
                        </div>
                        
                        <div class="game-card" data-game="valorant">
                            <img src="../../../images/standardGameImages/valorant-tournament-slide.jpg" alt="Valorant Tournament Slide">
                            <span>Valorant</span>
                        </div>

                        <div class="game-card" data-game="overwatch">
                            <img src="../../../images/standardGameImages/overwatch-tournament-slide.jpg" alt="Overwatch Tournament Slide">
                            <span>Overwatch</span>
                        </div>

                        <div class="game-card" data-game="rivals">
                            <img src="../../../images/standardGameImages/rivals-tournament-slide.jpg" alt="Rivals Tournament Slide">
                            <span>Marvel Rivals</span>
                        </div>

                        <div class="game-card" data-game="rocket league">
                            <img src="../../../images/standardGameImages/rocket-league-tournament-slide.jpg" alt="Rocket League Tournament Slide">
                            <span>Rocket League</span>
                        </div>

                        <div class="game-card" data-game="fortnite">
                            <img src="../../../images/standardGameImages/fortnite-tournament-slide.jpg" alt="Fortnite Tournament Slide">
                            <span>Fortnite</span>
                        </div>

                        <div class="game-card" data-game="king of fighters">
                            <img src="../../../images/standardGameImages/king-of-fighters-tournament-slide.jpg" alt="King of Fighters Tournament Slide">
                            <span>King of Fighters</span>
                        </div>

                        <!-- Add as many as you want -->
                    </div>
                </div>

                <button class="slideshow-button right">&#10095;</button>
            </section>

            <!-- Tournaments Viewport Section -->
            <section id="tournaments-viewport-section">
                
                <!-- Tournament Viewport Title -->
                <h1 id="tournaments-viewport-title">Tournaments & Events</h1>

                <% if (tournaments.length !== 0){ %> 

                    <!-- Tournament Viewport Container -->
                    <div id="tournaments-viewport-container">

                        <!-- Main section to view the tournaments for certain games. -->
                        <% if (tournamentsAr.SectionAspectRatio === 'ar-16-9'){ %> <!-- Tournaments Aspect Ratio 16:9 -->
                            <div class="game-viewport ar-16-9" data-game="all">
                                <h2>All</h2>

                                <!-- All Apex Legends Tournaments -->
                                <div class="game-viewport-game game-viewport-game-ar-16-9"></div>

                                <!-- All Marvel Rivals Tournaments -->
                                <div class="game-viewport-game game-viewport-game-ar-16-9"></div>

                                <!-- All Marvel Rivals Tournaments -->
                                <div class="game-viewport-game game-viewport-game-ar-16-9"></div>
                            </div>

                            <!-- Marvel Rivals Tournaments -->
                            <div class="game-viewport ar-16-9" game-data="rivals"></div>

                            <!-- Call of Duty Warzone Tournaments -->
                            <div class="game-viewport ar-16-9" game-data="warzone"></div>

                            <!-- Apex Legends Tournaments -->
                            <div class="game-viewport ar-16-9" game-data="apex"></div>

                            <!-- Valorant Tournaments -->
                            <div class="game-viewport ar-16-9" game-data="valorant"></div>

                            <!-- Overwatch Tournaments -->
                            <div class="game-viewport ar-16-9" game-data="overwatch"></div>

                            <!-- Rocket League Tournaments -->
                            <div class="game-viewport ar-16-9" game-data="rocket league"></div>

                            <!-- Fortnite Tournaments -->
                            <div class="game-viewport ar-16-9" game-data="fortnite"></div>

                            <!-- King of Fighters Tournaments -->
                            <div class="game-viewport ar-16-9" game-data="king of fighters"></div>

