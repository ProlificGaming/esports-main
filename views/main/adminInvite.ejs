<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Admin Invite</title>
        <link rel="stylesheet" href="/styles/adminStyles.css">
    </head>

    <body class="theme-<%=theme %>">
        <%- include("../utils/adminNav.ejs", { logInColor: '#65a30d' }) %>
        
        <main id="admin-invite-main" class="admin-dashboard-setup">
            <section class="profile-info">
                <h2>Welcome <%= username %></h2> 
                <p>Role: <%= role %></p>
            </section>

            <%- include("../utils/adminSidebar.ejs")  %>

            <section class="admin-invite-section">
                <h2>Admin Invite</h2>

                <section class="admin-invite-section-1">
                    <h3>Invite station</h3>
                    <form action="/admin/dashboard/invite" method="POST">
                        <div>
                            <label for="inviteRole">Invite Type</label>
                            <select name="inviteRole" id="inviteRole">
                                <option value="SuperAdmin">Super Admin</option>
                                <option value="Admin">Admin</option>
                                <option value="Mod">Mod</option>
                            </select>
                        </div>

                        <div>
                            <label for="inviteEmail">Email Invite</label>
                            <input type="email" name="inviteEmail" id="inviteEmail" placeholder="Please enter an email" required />
                        </div>

                        <div>
                            <button type="submit">Send Invite</button>
                        </div>
                    </form>
                </section>
            </section>

         
        </main>  
    </body>
</html>